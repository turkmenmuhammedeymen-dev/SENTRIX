/** SENTRIX mail relay. Deploy as a Google Apps Script Web App. */
function doPost(e){try{var b=JSON.parse((e&&e.postData&&e.postData.contents)||'{}'),token=PropertiesService.getScriptProperties().getProperty('SENTRIX_APPS_SCRIPT_TOKEN');if(!token||!b.token||b.token!==token)return json({ok:false,error:'UNAUTHORIZED'});if(b.action!=='sendAlert')return json({ok:false,error:'ACTION_NOT_ALLOWED'});var to=String(b.to||'').trim(),subject=String(b.subject||'SENTRIX Alert').slice(0,180),body=String(b.body||'').slice(0,10000);if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(to)||!body)return json({ok:false,error:'INVALID_INPUT'});MailApp.sendEmail({to:to,subject:subject,body:body,name:'SENTRIX Monitoring'});return json({ok:true});}catch(err){console.error(err);return json({ok:false,error:'MAIL_SEND_FAILED'});}}
function doGet(){return json({ok:true,service:'SENTRIX Mail Relay',status:'ready'});}
function json(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
